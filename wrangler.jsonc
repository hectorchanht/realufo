{
  "name": "realufo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application",
    // Worker sees every path except hashed bundles and robots.txt (Cloudflare Bot Preference Sync prepends to it):
    // navigations would otherwise skip it (broke window.open('/api/file/:id')), and
    // unknown paths need a real 404 instead of the SPA fallback's 200.
    "run_worker_first": ["/*", "!/assets/*", "!/robots.txt"] },
  "vars": { "RATE_MAX": "20", "RATE_WINDOW_SEC": "60",
    // Cached R2 custom domain: uploads must pass through the CDN cache for the CSAM Scanning Tool.
    "UPLOAD_BASE": "https://assets.realufo.org/uploads/",
    // Ask the Archive: off | hidden (endpoint only, for pre-launch eval) | on
    "FEATURE_ASK": "on", "ASK_DAILY_MAX": "2000", "ASK_MIN_SCORE": "0.45",
    // X bot (Spec 4): off | dry (drafts to x_posts, no X calls) | on.
    // X_HIGHLIGHT_MIN_VOTES "" = community highlights off (votes are forgeable; opt in deliberately)
    // X_POLLS "on" = cron posts each story's question as an X poll reply ("" = off; Spec 9)
    "FEATURE_X": "on", "X_PICK_HOURS": "15,18,21", "X_DAILY_MAX": "4", "X_MONTHLY_USD_CAP": "25", "X_HIGHLIGHT_MIN_VOTES": "", "X_SINCE": "2026-10-02", "X_POLLS": "on",
    // Social fan-out (Spec 5): mirrors x_posts to other platforms. off | dry | on per platform.
    "FEATURE_SOCIAL_FB": "on", "FEATURE_SOCIAL_IG": "on", "FEATURE_SOCIAL_THREADS": "on",
    "FEATURE_SOCIAL_BSKY": "on", "FEATURE_SOCIAL_YT": "on", "FEATURE_SOCIAL_TIKTOK": "on",
    "SOCIAL_SINCE": "2026-10-02", "YT_DAILY_MAX": "5", "TIKTOK_PRIVACY": "SELF_ONLY",
    // Web push (spec 2026-10-03-realufo-pwa-push-design): off | on. VAPID_PRIVATE_KEY is a secret.
    "FEATURE_PUSH": "off", "VAPID_PUBLIC_KEY": "BPy0ZG9mMzsBrEfpRAGd692XyYpKLXIDxUA72G9417AylXXJ-aSbJ9g7xBkEvONuIsI8RFKUXhzumGgqS1eTns4", "VAPID_SUBJECT": "mailto:hello@realufo.org" },
  "d1_databases": [{ "binding": "DB", "database_name": "realufo-db", "database_id": "a8836cc9-9f49-42bd-ad99-4162b410bcd9", "migrations_dir": "db/migrations" }],
  // No `remote: true`: it breaks the vitest workers pool. Vectorize has no local
  // simulator, so /api/ask returns 503 under `wrangler dev`.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "realufo-chunks" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "realufo" }],
  // www (DNS still points at the old GitHub Pages site) → 301 to the apex in the Worker.
  "routes": [{ "pattern": "realufo.org/*", "zone_name": "realufo.org" }, { "pattern": "www.realufo.org/*", "zone_name": "realufo.org" }],
    "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "triggers": { "crons": ["0 */3 * * *"] }
}
